---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import Search from "../components/icons/Search.astro";
import Play from "../components/icons/Play.astro";
---

<PrimaryLayout>
  <section class="mt-28 md:mt-32 w-full" id="">
    <form action="" id="search-form" class="">
      <div class="relative w-full">
        <input
          type="text"
          placeholder="Search"
          value=""
          class="w-full p-3 pr-14 rounded-full border"
        />
        <button
          type="submit"
          class="absolute right-2 top-1/2 -translate-y-1/2 p-2 size-10 rounded-full flex items-center justify-center cursor-pointer"
        >
          <Search />
        </button>
      </div>
    </form>
  </section>

  <section class="w-full mt-8 hidden" id="result-section">
    <div class="flex items-center justify-between">
      <div class="flex flex-col gap-2">
        <h1 id="word-title" class="text-4xl font-semibold">Random</h1>
        <span id="word-phonetic" class="">Random text</span>
      </div>
      <div
        class="p-3 border size-10 rounded-full flex items-center justify-center cursor-pointer"
      >
        <Play />
      </div>
    </div>
  </section>

  <section id="meanings-container" class="w-full mt-12"></section>
</PrimaryLayout>


<script>
  // 1. Selectors (Keep these at the top)
  const searchForm = document.getElementById("search-form") as HTMLFormElement;
  const input = searchForm.querySelector("input") as HTMLInputElement;
  const resultSection = document.getElementById(
    "result-section",
  ) as HTMLDivElement;
  const wordTitle = document.getElementById("word-title") as HTMLHeadingElement;
  const wordPhonetic = document.getElementById(
    "word-phonetic",
  ) as HTMLSpanElement;
  const meaningsContainer = document.getElementById(
    "meanings-container",
  ) as HTMLDivElement;

  // 2. Main Event Listener
  searchForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const value = input.value.trim();
    if (!value) return;

    try {
      const response = await fetch(
        `https://api.dictionaryapi.dev/api/v2/entries/en/${value}`,
      );

      if (!response.ok) {
        handleError("Word not found");
        return;
      }

      const data = await response.json();
      displayResult(data[0]);
    } catch (error) {
      handleError("Network error or invalid word");
    }
  });

  // 3. UI Logic Functions
  function displayResult(data: any) {
    // Reset and Show
    resultSection.classList.remove("hidden");
    resultSection.style.display = "block";
    meaningsContainer.innerHTML = "";

    wordTitle.textContent = data.word;
    wordPhonetic.textContent =
      data.phonetic || data.phonetics?.find((p: any) => p.text)?.text || "";

    // Build Meanings
    const htmlContent = data.meanings.map(renderMeaningBlock).join("");
    meaningsContainer.innerHTML = htmlContent;
  }

  // 4. Component-like Templates (Cleaner Mapping)
  function renderMeaningBlock(meaning: any) {
    const definitions = meaning.definitions
      .slice(0, 5)
      .map((def: any) => `<li>${def.definition}</li>`)
      .join("");

    const synonyms =
      meaning.synonyms?.length > 0
        ? `
        <div class="mt-8 flex gap-4 items-center">
          <span class="text-gray-400">Synonyms</span>
          <div class="flex flex-wrap gap-2">
            ${meaning.synonyms
              .slice(0, 3)
              .map(
                (s: string) =>
                  `<span class="text-purple-600 font-bold">${s}</span>`,
              )
              .join("")}
          </div>
        </div>`
        : "";

    return `
      <div class="mb-12">
        <div class="flex items-center gap-4">
          <span class="italic font-bold text-lg">${meaning.partOfSpeech}</span>
          <hr class="flex-1 border-t border-gray-400" />
        </div>
        <div class="mt-8">
          <p class="text-gray-400">Meaning</p>
          <ul class="list-disc ml-6 space-y-2 mt-4 marker:text-purple-500">
            ${definitions}
          </ul>
        </div>
        ${synonyms}
      </div>
    `;
  }

  function handleError(msg: string) {
    resultSection.style.display = "none";
    meaningsContainer.innerHTML = `<p class="text-center mt-10 text-red-500">${msg}</p>`;
  }
</script>

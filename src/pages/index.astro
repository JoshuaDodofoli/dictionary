---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import Search from "../components/icons/Search.astro";
import Play from "../components/icons/Play.astro";
---

<PrimaryLayout>
  <section class="mt-28 md:mt-32 w-full" id="">
    <form action="" id="search-form" class="">
      <div class="relative w-full">
        <input
          type="text"
          placeholder="Search"
          value=""
          class="w-full p-3 pr-14 rounded-full border"
        />
        <button
          type="submit"
          class="absolute right-2 top-1/2 -translate-y-1/2 p-2 size-10 rounded-full flex items-center justify-center cursor-pointer"
        >
          <Search />
        </button>
      </div>
    </form>
  </section>

  <section class="w-full mt-8 hidden" id="result-section">
    <div class="flex items-center justify-between">
      <div class="flex flex-col gap-2">
        <h1 id="word-title" class="text-4xl font-semibold">Random</h1>
        <span id="word-phonetic" class="">Random text</span>
      </div>
      <div
        class="p-3 border size-10 rounded-full flex items-center justify-center cursor-pointer"
      >
        <Play />
      </div>
    </div>
  </section>

  <section id="meanings-container" class="w-full mt-12"></section>
</PrimaryLayout>

<script>
  const searchForm = document.getElementById("search-form") as HTMLFormElement;
  const wordTitle = document.getElementById("word-title") as HTMLHeadingElement;
  const input = searchForm.querySelector("input") as HTMLInputElement;
  const resultSection = document.getElementById(
    "result-section",
  ) as HTMLDivElement;
  const wordPhonetic = resultSection.querySelector("#word-phonetic") as HTMLSpanElement;
  const meaningsContainer = document.getElementById(
    "meanings-container",
  ) as HTMLDivElement;

  searchForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const value = input.value.trim();
    if (!value) return;

    // if (wordTitle) wordTitle.textContent = value;

    try {
      const response = await fetch(
        `https://api.dictionaryapi.dev/api/v2/entries/en/${value}`,
      );
      if (!response.ok) throw new Error("Failed to fetch word data");

      const data = await response.json();
      displayResult(data[0]);
      console.log(data);
    } catch (error) {
      console.error(error);
      alert("Oops! Could not find that word.");
    }

    function displayResult(data: any) {
      if (!resultSection || !wordTitle || !meaningsContainer) return;

      resultSection.style.display = "block";
      wordTitle.textContent = data.word;
      wordPhonetic.textContent = data.phonetic || "";


      meaningsContainer.innerHTML = data.meanings.map((meaning: any) => {
        return `
           <div class="flex items-center gap-4">
      <span>${meaning.partOfSpeech}</span>
      <hr class="flex-1 border-t border-gray-400" />
    </div>

    <div class="mt-8">
      <span class="text-gray-400">Meaning</span>
      <ul class="indent-6 list-disc space-y-2 mt-2">
       ${meaning.definitions.slice(0, 5).map(
         (def: any) =>
           `<li>${def.definition}</li>
        `,
       ).join("")}
      </ul>
    </div>

    ${
      meaning.synonyms && meaning.synonyms.length > 0
        ? `
     <div class="mt-8">
      <span class="text-gray-400">Synonyms</span>
      <div class="indent-6 list-disc space-y-2 mt-2">
        ${meaning.synonyms.slice(0, 3).map(
          (syn: string) =>
            `<span class=" bg-gray-200 px-2 py-1 rounded-full text-sm mt-2">${syn}</span>
          `,
        ).join("")}
      </div>
    </div>
    `
        : ""
    }
        `;
      });
    }
  });
</script>

---
import Book from "../components/icons/Book.astro";
import ChevronDown from "./icons/Chevron-down.astro";

const fonts = ["Serif", "Mono", "Sans-serif"];
---
<div class="fixed w-full top-0 left-0 right-0 z-60">
    <nav class="w-full flex items-center justify-between px-4 h-24 max-w-2xl mx-auto">
        <div class="">
    <Book />
  </div>
  
  <div class="flex gap-2">
    <div id="font-btn"
      class="flex relative px-2 py-1 items-center gap-1 cursor-pointer"
    >
      <div class="w-18">
        <span class="font-semibold text-base">Serif</span>
        <ul id="font-list"
        class="absolute w-full scale-0 origin-top -translate-x-2 mt-2 gap-1 flex flex-col"
        >
        {fonts.map((font) => <li id="font-item" class="bg-black z-60 text-white rounded-full text-xs px-2 py-1">{font}</li>)}
    </ul>
      </div>
      <div id="chevron" class="">
        <ChevronDown />
      </div>
    </div>
      <hr class="h-6 w-0.5 bg-black/30 border-none" />
    <div class="">Mode</div>
</div>
</nav>
</div>

<script>
    import { animate, stagger } from "motion";
    
    const fontBtn = document.getElementById('font-btn');
    const chevron = document.getElementById('chevron');
    const fontList = document.getElementById('font-list');
    const fontItems = document.querySelectorAll('#font-item');

let isOpen = false;

fontBtn?.addEventListener('click', () => {
    isOpen = !isOpen;
    
    if (isOpen) {
        fontList?.classList.remove('hidden');
        fontList?.classList.add('scale-100');
        animate(fontList, { opacity: [0, 1], y: [-20, 0], scale: [0, 1] });
        animate(fontItems, { opacity: [0, 1], y: [-20, 0]}, { delay: stagger(0.1) });
    } else {
        animate(fontList, { scale: [1, 0.2], y: [1, 0.2], opacity: [0.6, 0] });
        animate(fontItems, { opacity: [1, 0], y: [0, -10] }, { delay: stagger(0.1), type: 'spring', bounce: 0.25 });
    }
    animate(chevron, { rotate: isOpen ? 180 : 0 });
})


</script>
